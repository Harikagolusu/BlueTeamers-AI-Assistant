# =============================================================================
# BlueTeamers AI Service - Environment Template
# =============================================================================
# THE single deployment switch:
#   DEVELOPMENT_MODE=true  -> Development mode (OmniRoute + local models, local
#                             MCP servers, DEBUG logging, permissive CORS).
#   DEVELOPMENT_MODE=false -> Production mode (DeepSeek API, INFO logging,
#                             locked-down CORS).
#
# Every environment-specific value derives from this flag unless explicitly
# overridden below. See app/core/config.py for the full list.

# Application
APP_NAME=BlueTeamers AI Service
APP_VERSION=1.0.0
DEVELOPMENT_MODE=true

# Security
SECRET_KEY=change_me
JWT_SECRET=change_me
# Path to the RS256 public key used to verify Django-issued JWTs.
JWT_PUBLIC_KEY_PATH=
# JSON list of allowed CORS origins (pydantic-settings parses env as JSON).
# Derived: development -> *, production -> [] (must be set explicitly in prod).
# CORS_ORIGINS=["https://app.example.com","https://www.example.com"]

# Django Integration (Django backend base URL)
DJANGO_API_URL=http://localhost:8000/api

# Freemium AI access
# Guests are limited to FREEMIUM_FREE_MESSAGE_LIMIT messages/day per client_id
# AND per source IP (FREEMIUM_GUEST_IP_KEYED) so rotating the client_id cannot
# mint a fresh allowance. Disable IP keying only if all clients legitimately
# share one IP (AI service not reachable from the public internet).
FREEMIUM_GUEST_IP_KEYED=true

# Database (currently unused; kept optional for future use)
POSTGRES_URL=

# Cache
REDIS_URL=redis://localhost:6379/0

# LLM
# LLM_PROVIDER derives from DEVELOPMENT_MODE: development -> omniroute, production -> deepseek.
# Allowed explicit values: omniroute | deepseek | auto
# LLM_PROVIDER=omniroute

# OmniRoute (development)
OMNIROUTE_API_KEY=
# OMNIROUTE_BASE_URL derives to http://localhost:20128/v1 in development.
OMNIROUTE_MODEL=oc/deepseek-v4-flash-free

# MCP servers (optional, config-driven). Inline JSON or a JSON file path:
#   MCP_SERVERS_CONFIG={"servers":{"filesystem":{"transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","."]}}}
#   MCP_SERVERS_CONFIG_PATH=/etc/blueteamers/mcp_servers.json
MCP_ENABLED=true
MCP_SERVERS_CONFIG=
MCP_SERVERS_CONFIG_PATH=

# Vector Database
VECTOR_DB_PATH=./vector_store

# Logging
# LOG_LEVEL derives from DEVELOPMENT_MODE (DEBUG dev / INFO prod).
# LOG_LEVEL=INFO

# Demo Mode (development only; auto-disabled in production)
ENABLE_DEMO_MODE=true
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Assessment Agent (interactive in-chat quizzes)
ENABLE_ASSESSMENT_AGENT=true
ASSESSMENT_MINIMUM_CONFIDENCE_THRESHOLD=0.6
ASSESSMENT_DEFAULT_QUIZ_LENGTH=5
ASSESSMENT_DEFAULT_DIFFICULTY=beginner
ASSESSMENT_MAXIMUM_QUESTIONS=10
ASSESSMENT_ALLOW_ADAPTIVE_DIFFICULTY=true
